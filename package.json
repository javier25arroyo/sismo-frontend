{
  "name": "sismo-frontend",
  "version": "0.2.4",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "check": "pnpm audit --audit-level=moderate && pnpm lint && pnpm test --watch=false && pnpm build",
    "update": "pnpm update",
    "update:latest": "pnpm update --latest",
    "security": "pnpm audit",
    "serve:ssr:sismo-frontend": "node dist/sismo-frontend/server/server.mjs"
  },
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "24.16.0",
    "pnpm": "10.32.1"
  },
  "pnpm": {
    "overrides": {
      "tar": ">=7.5.13",
      "vite": ">=7.3.2"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "lmdb",
      "msgpackr-extract"
    ]
  },
  "dependencies": {
    "@angular/animations": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-server": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/ssr": "^22.0.0",
    "chart.js": "^4.5.1",
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "leaflet": "^1.9.4",
    "lucide-angular": "^1.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.12.4",
    "angular-eslint": "21.4.0",
    "eslint": "^10.4.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.60.0",
    "vitest": "^4.1.8",
    "vitest-axe": "^0.1.0"
  }
}
